# GitHub Personal Access Token for the AI Claude agent.
# DO NOT commit this file with a real token.
#
# Required GitHub PAT scopes:
#   - repo (read:all — to search and read private repos in the Kafi org)
#   - read:org (to list org members and repos)
#
# How to apply:
#   1. Create a PAT at https://github.com/settings/tokens
#   2. Copy this file to github-pat-secret.yaml
#   3. Replace <REPLACE_WITH_GITHUB_PAT> with the actual token
#   4. Apply: kubectl apply -f github-pat-secret.yaml
#   5. Delete github-pat-secret.yaml (never commit the real token)
#
# Or create directly via kubectl:
#   kubectl create secret generic ai-claude-github-pat \
#     --from-literal=token=<YOUR_PAT> \
#     -n maintenance
---
apiVersion: v1
kind: Secret
metadata:
  name: ai-claude-github-pat
  namespace: maintenance
type: Opaque
stringData:
  token: "<REPLACE_WITH_GITHUB_PAT>"
